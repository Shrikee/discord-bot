{
  "name": "discord-bot",
  "version": "0.1.0",
  "description": "Discord bot client for the dcs-agent research backend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "register-commands": "tsx src/deploy-commands.ts",
    "register-commands:guild": "tsx src/deploy-commands-guild.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "tsx src/scripts/integration-test.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@sentry/node": "^10.49.0",
    "discord.js": "^14.16.3",
    "dotenv": "^17.3.1",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^4.1.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
