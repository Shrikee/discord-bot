# ─── Discord ──────────────────────────────────────────────
# Bot token from the Discord developer portal (Bot page).
DISCORD_TOKEN=
# Application ID (Discord developer portal → General Information).
DISCORD_CLIENT_ID=
# Optional, dev-only. Guild (server) ID for the guild-scoped dev-loop
# registration (`npm run register-commands:guild`) — propagates instantly,
# but only in that one server. Leave blank for production / global use.
# Right-click the server in Discord (with Developer Mode on) → Copy Server ID.
DISCORD_GUILD_ID=

# ─── Agent backend (dcs-agent) ────────────────────────────
# Base URL of the running dcs-agent HTTP server.
AGENT_API_URL=http://localhost:3000
# Must match the agent's API_KEY env var (sent as Authorization: Bearer ...).
AGENT_API_KEY=

# ─── Tuning ───────────────────────────────────────────────
# How long to wait for the agent before aborting (ms). Default 10 minutes.
AGENT_REQUEST_TIMEOUT_MS=600000
# Minimum interval between Discord reply edits during streaming (ms).
# Discord rate-limits edits to ~5 per 5s per channel — 1000ms is safe.
EDIT_THROTTLE_MS=1000

# ─── Observability ────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
# Optional. When unset, @sentry/node is never loaded (zero overhead).
# Set to the DSN from your Sentry project to enable error reporting.
SENTRY_DSN=
# Sentry environment tag (e.g. production, staging). Defaults to "production".
SENTRY_ENVIRONMENT=production
# Optional release identifier (git SHA or semver) forwarded to Sentry.
RELEASE=
